{
  "name": "trebell-code",
  "version": "1.3.6",
  "description": "Trebell Code Desktop - a multi-harness coding workspace with repository intelligence, browser verification, Git/worktree workflows, remote environments, and runtime-aware agent capabilities.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "trebell": "./bin/trebell.mjs",
    "trebell-code": "./bin/trebell.mjs"
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.mjs",
    "test:fast": "node --import tsx --test --test-concurrency=1 --test-isolation=none tests/*.test.mjs",
    "bench:core": "node scripts/benchmark-core.mjs",
    "doctor": "node ./bin/trebell.mjs doctor",
    "smoke:bridge": "node --import tsx ./vendor/freebuff2api/src/index.ts --help",
    "ui:dev": "vite --config ui/vite.config.mjs",
    "ui:build": "vite build --config ui/vite.config.mjs",
    "gui:server": "node src/gui-server.mjs",
    "gui": "npm run ui:build && node src/gui-server.mjs --open",
    "ui:test": "playwright test -c ui/playwright.config.mjs",
    "ui:test:workspace": "playwright test -c ui/playwright.config.mjs ui/e2e/harness.spec.js ui/e2e/history-pagination.spec.js ui/e2e/live-turn-settings.spec.js ui/e2e/queue.spec.js",
    "ui:test:capabilities": "playwright test -c ui/playwright.config.mjs ui/e2e/collaboration-mode.spec.js ui/e2e/external-import.spec.js ui/e2e/guardian.spec.js ui/e2e/memory.spec.js ui/e2e/plugins.spec.js ui/e2e/project-identity.spec.js ui/e2e/skills.spec.js ui/e2e/usage-live.spec.js ui/e2e/windows-sandbox.spec.js",
    "ui:test:visual": "playwright test -c ui/playwright.config.mjs ui/e2e/visual.spec.js",
    "bridge:build": "esbuild vendor/freebuff2api/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=vendor/freebuff2api/dist/index.mjs",
    "desktop:dir": "npm run prepare:icon && npm run bridge:build && npm run ui:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:dist:windows",
    "desktop:dist:windows": "npm run prepare:icon && npm run bridge:build && npm run ui:build && electron-builder --win nsis --x64",
    "desktop:dist:mac": "npm run prepare:icon && npm run bridge:build && npm run ui:build && electron-builder --mac dmg zip",
    "desktop:dist:linux": "npm run prepare:icon && npm run bridge:build && npm run ui:build && electron-builder --linux AppImage deb",
    "test:vyce": "node --env-file-if-exists=.env tests/live-vyce-smoke.mjs --live",
    "test:vyce:agent": "npm run test:vyce:codex",
    "test:vyce:codex": "node --env-file-if-exists=.env scripts/live-vyce-agent-test.mjs --live",
    "test:vyce:native": "node --env-file-if-exists=.env scripts/live-vyce-native-agent-test.mjs --live",
    "bench:vyce:native": "node --env-file-if-exists=.env scripts/live-vyce-native-benchmark.mjs --live",
    "bench:vyce:native:recovery": "node --env-file-if-exists=.env scripts/live-vyce-native-recovery-benchmark.mjs --live",
    "bench:vyce:native:hot-history": "node --env-file-if-exists=.env scripts/live-vyce-native-hot-history-benchmark.mjs --live",
    "bench:vyce:native:hot-preview": "node --env-file-if-exists=.env scripts/live-vyce-native-hot-preview-benchmark.mjs --live",
    "bench:vyce:native:post-edit-reread": "node --env-file-if-exists=.env scripts/live-vyce-native-post-edit-reread-benchmark.mjs --live",
    "bench:vyce:native:schema-min": "node --env-file-if-exists=.env scripts/live-vyce-native-schema-min-benchmark.mjs --live",
    "bench:vyce:native:shared-schema": "node --env-file-if-exists=.env scripts/live-vyce-native-shared-schema-benchmark.mjs --live",
    "bench:vyce:native:tool-namespace": "node --env-file-if-exists=.env scripts/live-vyce-native-tool-namespace-benchmark.mjs --live",
    "bench:vyce:native:output-inspect": "node --env-file-if-exists=.env scripts/live-vyce-native-output-inspect-benchmark.mjs",
    "bench:native:dedupe": "node scripts/native-observation-dedupe-benchmark.mjs",
    "bench:native:cache-history": "node scripts/native-cache-history-benchmark.mjs",
    "bench:native:cross-turn-verifier": "node scripts/native-cross-turn-verifier-benchmark.mjs",
    "bench:native:terminal-report": "node scripts/native-terminal-report-benchmark.mjs",
    "bench:native:terminal-report-history": "node scripts/native-terminal-report-history-benchmark.mjs",
    "bench:native:direct-terminal-status": "node scripts/native-direct-terminal-status-benchmark.mjs",
    "bench:native:direct-terminal-history": "node scripts/native-direct-terminal-history-benchmark.mjs",
    "bench:native:direct-terminal-history-overhead": "node scripts/native-direct-terminal-history-overhead-benchmark.mjs",
    "bench:native:direct-terminal-scan": "node --expose-gc scripts/native-direct-terminal-scan-benchmark.mjs",
    "bench:native:direct-status-lazy-output": "node --expose-gc scripts/native-direct-status-lazy-output-benchmark.mjs",
    "bench:native:direct-terminal-provider-view-incremental": "node --expose-gc scripts/native-direct-terminal-provider-view-incremental-benchmark.mjs",
    "bench:native:request-metrics-overhead": "node --expose-gc scripts/native-request-metrics-overhead-benchmark.mjs",
    "bench:native:message-bucket-metrics": "node --expose-gc scripts/native-message-bucket-metrics-benchmark.mjs",
    "bench:native:message-array-allocation": "node --expose-gc scripts/native-message-array-allocation-benchmark.mjs",
    "bench:native:message-serialization-cache": "node --expose-gc scripts/native-message-serialization-cache-benchmark.mjs",
    "bench:native:history-hash-cache": "node --expose-gc scripts/native-history-hash-cache-benchmark.mjs",
    "bench:native:message-classification-cache": "node --expose-gc scripts/native-message-classification-cache-benchmark.mjs",
    "bench:native:current-turn-breakdown-cache": "node --expose-gc scripts/native-current-turn-breakdown-cache-benchmark.mjs",
    "bench:native:classified-byte-metrics": "node --expose-gc scripts/native-classified-byte-metrics-benchmark.mjs",
    "bench:native:provider-history-projector": "node --expose-gc scripts/native-provider-history-projector-benchmark.mjs",
    "bench:native:provider-history-compacted-identity": "node --expose-gc scripts/native-provider-history-compacted-identity-benchmark.mjs",
    "bench:native:tool-schema-metrics-cache": "node --expose-gc scripts/native-tool-schema-metrics-cache-benchmark.mjs",
    "bench:native:latest-user-lookup": "node --expose-gc scripts/native-latest-user-lookup-benchmark.mjs",
    "bench:native:tool-repair-scan": "node --expose-gc scripts/native-tool-repair-scan-benchmark.mjs",
    "bench:native:chat-tool-manifest-cache": "node --expose-gc scripts/chat-tool-manifest-cache-benchmark.mjs",
    "bench:native:chat-message-cache": "node --expose-gc scripts/chat-message-conversion-cache-benchmark.mjs",
    "bench:native:prefix-hash-overhead": "node --expose-gc scripts/native-prefix-hash-overhead-benchmark.mjs",
    "bench:native:incremental-history-cooling": "node scripts/native-incremental-history-cooling-benchmark.mjs",
    "bench:thread:metadata": "node --expose-gc scripts/agent-thread-metadata-benchmark.mjs",
    "bench:native:direct-terminal-cwd": "node scripts/native-direct-terminal-cwd-benchmark.mjs",
    "bench:native:direct-exact-replacement": "node scripts/native-direct-exact-replacement-benchmark.mjs",
    "bench:native:direct-exact-replacement-only": "node scripts/native-direct-exact-replacement-only-benchmark.mjs",
    "bench:native:direct-exact-replacement-cwd": "node scripts/native-direct-exact-replacement-cwd-benchmark.mjs",
    "bench:native:direct-exact-write": "node scripts/native-direct-exact-write-benchmark.mjs",
    "bench:native:direct-exact-read": "node scripts/native-direct-exact-read-benchmark.mjs",
    "bench:native:direct-exact-list": "node scripts/native-direct-exact-list-benchmark.mjs",
    "bench:native:direct-git-status": "node scripts/native-direct-git-status-benchmark.mjs",
    "bench:openai:response-continuation": "node scripts/openai-response-continuation-benchmark.mjs",
    "bench:openai:continuation-accounting": "node scripts/openai-continuation-accounting-benchmark.mjs",
    "bench:openai:continuation-byte-accounting": "node --expose-gc scripts/openai-continuation-byte-accounting-benchmark.mjs",
    "bench:openai:continuation-fingerprint-reuse": "node --expose-gc scripts/openai-response-continuation-fingerprint-benchmark.mjs",
    "bench:openai:continuation-input-build": "node --expose-gc scripts/openai-continuation-input-build-benchmark.mjs",
    "bench:openai:responses-websocket": "node scripts/openai-responses-websocket-benchmark.mjs",
    "bench:openai:responses-input-build": "node scripts/openai-responses-input-build-benchmark.mjs",
    "bench:openai:tool-manifest-cache": "node --expose-gc scripts/openai-tool-manifest-cache-benchmark.mjs",
    "bench:openai:prompt-cache-key-cache": "node --expose-gc scripts/openai-prompt-cache-key-cache-benchmark.mjs",
    "bench:anthropic:direct-input-build": "node --expose-gc scripts/anthropic-direct-input-build-benchmark.mjs",
    "bench:anthropic:message-build-cache": "node --expose-gc scripts/anthropic-message-build-cache-benchmark.mjs",
    "bench:anthropic:tool-manifest-cache": "node --expose-gc scripts/anthropic-tool-manifest-cache-benchmark.mjs",
    "bench:provider:tool-wire-json": "node --expose-gc scripts/provider-tool-wire-serialization-benchmark.mjs",
    "bench:native:tool-schema": "node scripts/native-tool-schema-benchmark.mjs",
    "bench:native:restart-verifier": "node scripts/native-restart-verifier-benchmark.mjs",
    "bench:native:restart-history": "node scripts/native-restart-history-benchmark.mjs",
    "bench:vyce:native:search-dedupe": "node --env-file-if-exists=.env scripts/live-vyce-native-search-dedupe-benchmark.mjs --live",
    "bench:vyce:native:budget-finalization": "node --env-file-if-exists=.env scripts/live-vyce-native-budget-finalization-benchmark.mjs --live",
    "bench:vyce:native:shell-hint": "node --env-file-if-exists=.env scripts/live-vyce-native-shell-hint-benchmark.mjs --live",
    "bench:vyce:native:toolcall-history": "node --env-file-if-exists=.env scripts/live-vyce-native-toolcall-history-benchmark.mjs --live",
    "bench:vyce:native:prior-context": "node --env-file-if-exists=.env scripts/live-vyce-native-prior-context-benchmark.mjs --live",
    "bench:vyce:native:prior-context-mixed": "node --env-file-if-exists=.env scripts/live-vyce-native-prior-context-mixed-benchmark.mjs --live",
    "test:vyce:cache": "node --env-file-if-exists=.env scripts/live-vyce-cache-test.mjs --live",
    "test:vyce:background": "node --env-file-if-exists=.env scripts/live-vyce-background-test.mjs --live",
    "test:vyce:fanout": "node --env-file-if-exists=.env scripts/live-vyce-fanout-test.mjs --live",
    "test:providers:live": "node --env-file-if-exists=.env scripts/live-provider-smoke.mjs --live",
    "test:runtime-profiles:live": "node --env-file-if-exists=.env scripts/live-runtime-profile-smoke.mjs --live",
    "test:external-harnesses:live": "node --env-file-if-exists=.env scripts/live-external-harness-smoke.mjs --live",
    "test:codex:live": "node --env-file-if-exists=.env scripts/live-codex-harness-smoke.mjs --live",
    "bench:harnesses:live": "node --env-file-if-exists=.env scripts/live-harness-comparison.mjs --live",
    "trace:export": "node scripts/export-event-replay.mjs",
    "trace:replay": "node scripts/replay-event-bundle.mjs",
    "prepare:icon": "node scripts/materialize-icon.mjs",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-windows-release.ps1",
    "release:windows:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-windows-release.ps1 -Publish"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@babel/parser": "^7.29.9",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.155.1",
    "@opencode-ai/sdk": "^1.3.15",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.468.0",
    "node-pty": "1.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.0",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "vite": "^7.1.5"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.trebell.code",
    "productName": "Trebell Code",
    "artifactName": "Trebell-Code-Setup-${version}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "desktop-dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "ui/dist/**/*",
      "vendor/freebuff2api/dist/**/*",
      "branding/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-win32-x64/**/*",
      "node_modules/@openai/codex-win32-arm64/**/*",
      "node_modules/@openai/codex-darwin-x64/**/*",
      "node_modules/@openai/codex-darwin-arm64/**/*",
      "node_modules/@openai/codex-linux-x64/**/*",
      "node_modules/@openai/codex-linux-arm64/**/*",
      "vendor/freebuff2api/dist/**/*",
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tanishqbaweja",
        "repo": "trebellcode"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trebell Code",
      "uninstallDisplayName": "Trebell Code",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "optionalDependencies": {
    "@openai/codex-win32-x64": "npm:@openai/codex@0.155.1-win32-x64"
  }
}
