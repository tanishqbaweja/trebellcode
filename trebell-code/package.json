{
  "name": "trebell-code",
  "version": "1.3.1",
  "description": "Trebell Code Desktop - a provider-agnostic Codex agent harness with browser automation, desktop snapshot context, Git/worktree workflows, remote environments, and Responses compatibility for third-party inference APIs.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "trebell": "./bin/trebell.mjs",
    "trebell-code": "./bin/trebell.mjs"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs",
    "bench:core": "node scripts/benchmark-core.mjs",
    "doctor": "node ./bin/trebell.mjs doctor",
    "smoke:bridge": "node --import tsx ./vendor/freebuff2api/src/index.ts --help",
    "ui:dev": "vite --config ui/vite.config.mjs",
    "ui:build": "vite build --config ui/vite.config.mjs",
    "gui:server": "node src/gui-server.mjs",
    "gui": "npm run ui:build && node src/gui-server.mjs --open",
    "ui:test": "npm run ui:build && playwright test -c ui/playwright.config.mjs",
    "ui:test:workspace": "playwright test -c ui/playwright.config.mjs ui/e2e/harness.spec.js ui/e2e/history-pagination.spec.js ui/e2e/live-turn-settings.spec.js ui/e2e/queue.spec.js",
    "ui:test:capabilities": "playwright test -c ui/playwright.config.mjs ui/e2e/collaboration-mode.spec.js ui/e2e/external-import.spec.js ui/e2e/guardian.spec.js ui/e2e/memory.spec.js ui/e2e/plugins.spec.js ui/e2e/project-identity.spec.js ui/e2e/skills.spec.js ui/e2e/usage-live.spec.js ui/e2e/windows-sandbox.spec.js",
    "ui:test:remote": "playwright test -c ui/playwright.config.mjs ui/e2e/remote-mobile.spec.js",
    "ui:test:visual": "playwright test -c ui/playwright.config.mjs ui/e2e/visual.spec.js",
    "bridge:build": "esbuild vendor/freebuff2api/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=vendor/freebuff2api/dist/index.mjs",
    "desktop:dir": "npm run prepare:icon && npm run bridge:build && npm run ui:build && electron-builder --dir",
    "desktop:dist": "npm run prepare:icon && npm run bridge:build && npm run ui:build && electron-builder --win nsis --x64",
    "test:vyce": "node --env-file-if-exists=../.env tests/live-vyce-smoke.mjs --live",
    "test:vyce:agent": "node --env-file-if-exists=../.env scripts/live-vyce-agent-test.mjs --live",
    "test:vyce:background": "node --env-file-if-exists=../.env scripts/live-vyce-background-test.mjs --live",
    "test:vyce:fanout": "node --env-file-if-exists=../.env scripts/live-vyce-fanout-test.mjs --live",
    "trace:export": "node scripts/export-event-replay.mjs",
    "trace:replay": "node scripts/replay-event-bundle.mjs",
    "prepare:icon": "node scripts/materialize-icon.mjs",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-windows-release.ps1",
    "release:windows:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-windows-release.ps1 -Publish"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@babel/parser": "^7.29.9",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.155.1",
    "@opencode-ai/sdk": "^1.3.15",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "node-pty": "1.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.0",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "vite": "^7.1.5"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.trebell.code",
    "productName": "Trebell Code",
    "artifactName": "Trebell-Code-Setup-${version}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "desktop-dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "ui/dist/**/*",
      "vendor/freebuff2api/dist/**/*",
      "branding/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-win32-x64/**/*",
      "node_modules/@openai/codex-win32-arm64/**/*",
      "vendor/freebuff2api/dist/**/*",
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tanishqbaweja",
        "repo": "trebellcode"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trebell Code",
      "uninstallDisplayName": "Trebell Code",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "optionalDependencies": {
    "@openai/codex-win32-x64": "npm:@openai/codex@0.155.1-win32-x64"
  }
}
